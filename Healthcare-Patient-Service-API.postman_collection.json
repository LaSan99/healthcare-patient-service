						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe Updated\",\n    \"phone\": \"0987654321\",\n    \"age\": 31,\n    \"gender\": \"Male\",\n    \"medicalHistory\": \"Updated medical history\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/patients/profile",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"patients",
								"profile"
							]
						}
					},
					"response": []
				},
				{
					"name": "Delete My Account",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/patients/profile",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"patients",
								"profile"
							]
						}
					},
					"response": []
				}
			]
		},
