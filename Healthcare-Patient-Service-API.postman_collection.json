{
	"info": {
		"_postman_id": "healthcare-patient-service",
		"name": "Healthcare Patient Service API",
		"description": "Complete API collection for Healthcare Patient Service with patient registration, profile management, and admin user management",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8081",
			"type": "string"
		},
		{
			"key": "patientEmail",
			"value": "patient@example.com",
			"type": "string"
		},
		{
			"key": "patientPassword",
			"value": "patient123",
			"type": "string"
		},
		{
			"key": "adminEmail",
			"value": "admin@example.com",
			"value": "admin123",
			"type": "string"
		}
	],
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "{{patientEmail}}",
				"type": "string"
			},
			{
				"key": "password",
				"value": "{{patientPassword}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Public Endpoints",
			"item": [
				{
					"name": "Register Patient",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"{{patientEmail}}\",\n    \"phone\": \"1234567890\",\n    \"age\": 30,\n    \"gender\": \"Male\",\n    \"medicalHistory\": \"No known allergies\",\n    \"password\": \"{{patientPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/patients/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"patients",
								"register"
							]
						}
					},
					"response": []
				},
				{
					"name": "Login",
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{patientEmail}}",
									"type": "string"
								},
								{
									"key": "password",
									"value": "{{patientPassword}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"url": {
							"raw": "{{baseUrl}}/patients/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"patients",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Patient Profile Management",
			"auth": {
				"type": "basic",
				"basic": [
					{
						"key": "username",
						"value": "{{patientEmail}}",
						"type": "string"
					},
					{
						"key": "password",
						"value": "{{patientPassword}}",
						"type": "string"
					}
